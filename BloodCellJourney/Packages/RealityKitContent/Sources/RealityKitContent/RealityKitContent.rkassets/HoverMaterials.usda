#usda 1.0
(
    customLayerData = {
        string creator = "Reality Composer Pro Version 2.0"
    }
    defaultPrim = "Root"
    metersPerUnit = 1
    upAxis = "Y"
)

def Xform "Root"
{
    def Material "VesselHoverRim"
    {
        token outputs:mtlx:surface.connect = </Root/VesselHoverRim/UnlitSurface.outputs:out>
        token outputs:realitykit:vertex
        float2 ui:nodegraph:realitykit:subgraphOutputs:pos = (1340, 160)

        def Shader "UnlitSurface"
        {
            uniform token info:id = "ND_realitykit_unlit_surfaceshader"
            bool inputs:applyPostProcessToneMap = 0
            color3f inputs:color = (1, 1, 1)
            bool inputs:hasPremultipliedAlpha = 0
            float inputs:opacity.connect = </Root/VesselHoverRim/Strength.outputs:out>
            token outputs:out
            float2 ui:nodegraph:node:pos = (1140, 160)
        }

        def Shader "Normal"
        {
            uniform token info:id = "ND_normal_vector3"
            string inputs:space = "world"
            float3 outputs:out
            float2 ui:nodegraph:node:pos = (60, 80)
        }

        def Shader "ViewDirection"
        {
            uniform token info:id = "ND_realitykit_viewdirection_vector3"
            string inputs:space = "world"
            float3 outputs:out
            float2 ui:nodegraph:node:pos = (60, 220)
        }

        def Shader "DotProduct"
        {
            uniform token info:id = "ND_dotproduct_vector3"
            float3 inputs:in1.connect = </Root/VesselHoverRim/Normal.outputs:out>
            float3 inputs:in2.connect = </Root/VesselHoverRim/ViewDirection.outputs:out>
            float outputs:out
            float2 ui:nodegraph:node:pos = (260, 150)
        }

        def Shader "Absolute"
        {
            uniform token info:id = "ND_absval_float"
            float inputs:in.connect = </Root/VesselHoverRim/DotProduct.outputs:out>
            float outputs:out
            float2 ui:nodegraph:node:pos = (420, 150)
        }

        def Shader "OneMinus"
        {
            uniform token info:id = "ND_subtract_float"
            float inputs:in1 = 1
            float inputs:in2.connect = </Root/VesselHoverRim/Absolute.outputs:out>
            float outputs:out
            float2 ui:nodegraph:node:pos = (580, 150)
        }

        def Shader "RimWidth"
        {
            uniform token info:id = "ND_power_float"
            float inputs:in1.connect = </Root/VesselHoverRim/OneMinus.outputs:out>
            float inputs:in2 = 3
            float outputs:out
            float2 ui:nodegraph:node:pos = (740, 150)
        }

        def Shader "HoverState"
        {
            uniform token info:id = "ND_realitykit_hover_state"
            float outputs:intensity
            float2 ui:nodegraph:node:pos = (580, 300)
        }

        def Shader "Multiply"
        {
            uniform token info:id = "ND_multiply_float"
            float inputs:in1.connect = </Root/VesselHoverRim/RimWidth.outputs:out>
            float inputs:in2.connect = </Root/VesselHoverRim/HoverState.outputs:intensity>
            float outputs:out
            float2 ui:nodegraph:node:pos = (860, 220)
        }

        def Shader "Strength"
        {
            uniform token info:id = "ND_multiply_float"
            float inputs:in1.connect = </Root/VesselHoverRim/Multiply.outputs:out>
            float inputs:in2 = 0.2
            float outputs:out
            float2 ui:nodegraph:node:pos = (1000, 220)
            int ui:nodegraph:node:stackingOrder = 1
        }
    }
}

