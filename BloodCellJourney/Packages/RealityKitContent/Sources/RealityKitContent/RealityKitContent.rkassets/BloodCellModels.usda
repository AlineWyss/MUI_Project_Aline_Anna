#usda 1.0
(
    defaultPrim = "Root"
    metersPerUnit = 1
    upAxis = "Y"
)

def Xform "Root"
{
    def Xform "RedBloodCell" (
        prepend apiSchemas = ["MaterialBindingAPI"]
        prepend references = @RedBloodCell.usdz@
    )
    {
        rel material:binding = </Root/RedBloodCell/_materials/Material_016> (
            bindMaterialAs = "weakerThanDescendants"
        )
        double3 xformOp:translate = (-0.8, 1.2, -1)
        uniform token[] xformOpOrder = ["xformOp:translate"]

        over "env_light" (
            active = false
        )
        {
        }

        over "_materials"
        {
            over "Material_016"
            {
                token inputs:frame:stPrimvarName = "st" (
                    customData = {
                        dictionary realitykit = {
                            bool hide = 1
                        }
                    }
                )
                token outputs:mtlx:surface
                token outputs:realitykit:vertex

                def Shader "diffuseColor"
                {
                    uniform token info:id = "UsdUVTexture"
                    asset inputs:file = @neue_Materilien/RedBloodCellNew/bright/Material.005_Base_color.png@
                    float2 inputs:st.connect = </Root/RedBloodCell/_materials/Material_016/diffuseColor/TexCoordReader.outputs:result>
                    color3f outputs:rgb

                    def Shader "TexCoordReader"
                    {
                        uniform token info:id = "UsdPrimvarReader_float2"
                        token inputs:varname.connect = </Root/RedBloodCell/_materials/Material_016.inputs:frame:stPrimvarName>
                        float2 outputs:result
                    }
                }

                over "Principled_BSDF"
                {
                    color3f inputs:diffuseColor.connect = </Root/RedBloodCell/_materials/Material_016/diffuseColor.outputs:rgb>
                    float inputs:metallic.connect = </Root/RedBloodCell/_materials/Material_016/metallic.outputs:r>
                    normal3f inputs:normal = (0, 0, 1)
                    normal3f inputs:normal.connect = </Root/RedBloodCell/_materials/Material_016/normal.outputs:rgb>
                    float inputs:occlusion = 1
                    float inputs:occlusion.connect = </Root/RedBloodCell/_materials/Material_016/occlusion.outputs:r>
                    float inputs:roughness.connect = </Root/RedBloodCell/_materials/Material_016/roughness.outputs:r>
                }

                def Shader "roughness"
                {
                    uniform token info:id = "UsdUVTexture"
                    asset inputs:file = @neue_Materilien/RedBloodCellNew/bright/Material.005_Specular_roughness.png@
                    float2 inputs:st.connect = </Root/RedBloodCell/_materials/Material_016/roughness/TexCoordReader.outputs:result>
                    float outputs:r

                    def Shader "TexCoordReader"
                    {
                        uniform token info:id = "UsdPrimvarReader_float2"
                        token inputs:varname.connect = </Root/RedBloodCell/_materials/Material_016.inputs:frame:stPrimvarName>
                        float2 outputs:result
                    }
                }

                def Shader "metallic"
                {
                    uniform token info:id = "UsdUVTexture"
                    asset inputs:file = @neue_Materilien/RedBloodCellNew/bright/Material.005_Base_metalness.png@
                    float2 inputs:st.connect = </Root/RedBloodCell/_materials/Material_016/metallic/TexCoordReader.outputs:result>
                    float outputs:r

                    def Shader "TexCoordReader"
                    {
                        uniform token info:id = "UsdPrimvarReader_float2"
                        token inputs:varname.connect = </Root/RedBloodCell/_materials/Material_016.inputs:frame:stPrimvarName>
                        float2 outputs:result
                    }
                }

                def Shader "normal"
                {
                    uniform token info:id = "UsdUVTexture"
                    asset inputs:file = @neue_Materilien/RedBloodCellNew/bright/Material.005_Normal_OpenGL.png@
                    float2 inputs:st.connect = </Root/RedBloodCell/_materials/Material_016/normal/TexCoordReader.outputs:result>
                    normal3f outputs:rgb

                    def Shader "TexCoordReader"
                    {
                        uniform token info:id = "UsdPrimvarReader_float2"
                        token inputs:varname.connect = </Root/RedBloodCell/_materials/Material_016.inputs:frame:stPrimvarName>
                        float2 outputs:result
                    }
                }

                def Shader "occlusion"
                {
                    uniform token info:id = "UsdUVTexture"
                    asset inputs:file = @neue_Materilien/RedBloodCellNew/bright/Material.005_Mixed_AO.png@
                    float2 inputs:st.connect = </Root/RedBloodCell/_materials/Material_016/occlusion/TexCoordReader.outputs:result>
                    float outputs:r

                    def Shader "TexCoordReader"
                    {
                        uniform token info:id = "UsdPrimvarReader_float2"
                        token inputs:varname.connect = </Root/RedBloodCell/_materials/Material_016.inputs:frame:stPrimvarName>
                        float2 outputs:result
                    }
                }
            }
        }
    }

